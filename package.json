{
  "name": "mcpwatchtower",
  "version": "0.1.0",
  "description": "Local-first CLI audits for MCP server configs before agents use them.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "mcpwatchtower": "./dist/src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "docs",
    "examples",
    "README.md",
    "RELEASE_NOTES.md",
    "SECURITY.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "prepack": "npm run build && chmod +x dist/src/cli.js",
    "package:smoke": "bash scripts/package-smoke.sh",
    "smoke": "npm run build && node dist/src/cli.js scan tests/fixtures/clean.json --format text --fail-on high",
    "consumer:smoke": "bash scripts/package-smoke.sh",
    "release:tag": "node scripts/check-release-tag.mjs",
    "test:release-tag": "node --test scripts/check-release-tag.test.mjs",
    "release:check": "npm test && npm run test:release-tag && npm run smoke && npm run consumer:smoke"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/mcpwatchtower.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/mcpwatchtower/issues"
  },
  "homepage": "https://github.com/rogerchappel/mcpwatchtower#readme",
  "keywords": [
    "mcp",
    "security",
    "cli",
    "audit"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  }
}
