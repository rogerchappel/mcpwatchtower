{
  "name": "mcpwatchtower",
  "version": "0.1.0",
  "description": "mcpwatchtower generated by StackForge.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "mcpwatchtower": "./dist/src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "package:smoke": "npm pack --dry-run",
    "smoke": "npm run build && node dist/src/cli.js scan fixtures/clean.json --format text --fail-on high",
    "release:check": "npm test && npm run package:smoke"
  },
  "keywords": [
    "mcp",
    "security",
    "cli",
    "audit"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  }
}
