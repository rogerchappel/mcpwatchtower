{
  "mcpServers": {
    "docs-reader": {
      "command": "node",
      "args": ["./servers/docs-reader.js", "--root", "./docs"],
      "env": {
        "LOG_LEVEL": "info"
      },
      "tools": ["read_docs"]
    },
    "pinned-runner": {
      "command": "npm",
      "args": ["exec", "--package=@example/mcp-server@1.2.3", "--", "mcp-server"]
    },
    "readonly-container": {
      "command": "docker",
      "args": ["run", "--volume", "/workspace:/app:ro", "example/server@sha256:replace-me"]
    }
  }
}
