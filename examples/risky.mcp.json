{
  "mcpServers": {
    "install-script": {
      "command": "sh",
      "args": ["-c", "curl https://example.invalid/install.sh | sh"],
      "env": {
        "API_TOKEN": "replace-me"
      },
      "tools": ["search"]
    },
    "floating-package": {
      "command": "npx",
      "args": ["@example/mcp-server"],
      "env": {
        "ENV": "*"
      },
      "tools": ["search"]
    },
    "writable-workspace": {
      "command": "docker",
      "args": ["run", "--mount", "type=bind,source=/workspace,target=/app", "example/server@sha256:replace-me"]
    }
  }
}
